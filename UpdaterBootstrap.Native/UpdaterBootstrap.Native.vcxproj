  <!-- Versionamento automatico: calcola Build/Revision e genera un .rc in obj prima della compilazione risorse -->
  <PropertyGroup>
    <!-- Giorni dal 1/1/2000 -->
    <Build>$([System.DateTime]::UtcNow.Subtract($([System.DateTime]::Parse("2000-01-01"))).Days)</Build>
    <!-- Secondi dall'inizio della giornata -->
    <Seconds>$([System.DateTime]::UtcNow.TimeOfDay.TotalSeconds)</Seconds>
    <!-- Divisione per 2 e troncamento -->
    <Revision>$([System.Math]::Floor($([MSBuild]::Divide($(Seconds), 2))))</Revision>
    <Version>1.1.0</Version>
    <!-- Formato numerico per VS_VERSION_INFO (virgole) -->
    <FileVersionNumeric>1,1,$(Build),$(Revision)</FileVersionNumeric>
    <FileVersion>1.1.$(Build).$(Revision)</FileVersion>
    <ProductVersionNumeric>1,1,0,0</ProductVersionNumeric>
    <ProductVersion>1.1.0</ProductVersion>
  </PropertyGroup>
  <Target Name="GenerateVersionResource" BeforeTargets="ResourceCompile">
    <PropertyGroup>
      <GeneratedRc>$(IntDir)GeneratedVersion.rc</GeneratedRc>
      <GeneratedHeader>$(IntDir)version.h</GeneratedHeader>
    </PropertyGroup>
    <MakeDir Directories="$(IntDir)" Condition="!Exists('$(IntDir)')" />
    <ItemGroup>
      <VersionRcLines Include="#include &quot;windows.h&quot;" />
      <VersionRcLines Include="#include &quot;winver.h&quot;" />
      <VersionRcLines Include="VS_VERSION_INFO VERSIONINFO" />
      <VersionRcLines Include=" FILEVERSION $(FileVersionNumeric)" />
      <VersionRcLines Include=" PRODUCTVERSION $(ProductVersionNumeric)" />
      <VersionRcLines Include=" BEGIN" />
      <VersionRcLines Include="  BLOCK &quot;StringFileInfo&quot;" />
      <VersionRcLines Include="  BEGIN" />
      <VersionRcLines Include="    BLOCK &quot;040904b0&quot;" />
      <VersionRcLines Include="    BEGIN" />
      <VersionRcLines Include="      VALUE &quot;CompanyName&quot;, &quot;Firefox_1998\0&quot;" />
      <VersionRcLines Include="      VALUE &quot;FileDescription&quot;, &quot;Updater Bootstrap\0&quot;" />
      <VersionRcLines Include="      VALUE &quot;FileVersion&quot;, &quot;$(FileVersion)\0&quot;" />
      <VersionRcLines Include="      VALUE &quot;InternalName&quot;, &quot;UpdaterBootstrap.exe\0&quot;" />
      <VersionRcLines Include="      VALUE &quot;OriginalFilename&quot;, &quot;UpdaterBootstrap.exe\0&quot;" />
      <VersionRcLines Include="      VALUE &quot;ProductName&quot;, &quot;UpdaterBootstrap\0&quot;" />
      <VersionRcLines Include="      VALUE &quot;ProductVersion&quot;, &quot;$(ProductVersion)\0&quot;" />
      <VersionRcLines Include="    END" />
      <VersionRcLines Include="  END" />
      <VersionRcLines Include="  BLOCK &quot;VarFileInfo&quot;" />
      <VersionRcLines Include="  BEGIN" />
      <VersionRcLines Include="    VALUE &quot;Translation&quot;, 0x0409, 1200" />
      <VersionRcLines Include="  END" />
      <VersionRcLines Include=" END" />
    </ItemGroup>
    <WriteLinesToFile File="$(GeneratedRc)" Lines="@(VersionRcLines)" Overwrite="true" Encoding="UTF-8" />
    <Message Text="Generato $(GeneratedRc) con FileVersion=$(FileVersion)" Importance="high" />
    <!-- Aggiunge il file generato alla compilazione risorse -->
    <ItemGroup>
      <ResourceCompile Include="$(GeneratedRc)" />
    </ItemGroup>
